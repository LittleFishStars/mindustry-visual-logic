[gd_scene format=3 uid="uid://bbc36pgut7e0g"]

[sub_resource type="GDScript" id="GDScript_c5vtr"]
resource_name = "notice_window"
script/source = "extends Window


var NoticeItem := preload(\"res://srcs/controls/notice_item.tscn\")

@onready var Request: HTTPRequest = $Request
@onready var nList: VBoxContainer = $Container/Scroll/Margin/NoticeList


func _ready() -> void:
	self.Request.request(\"https://textdb.online/MindVisualLogic\")


func _on_request_completed(_result: int, _response_code: int, _headers: PackedStringArray, body: PackedByteArray):
	var json = JSON.parse_string(body.get_string_from_utf8())
	self.title = json.get(\"title\", self.title)
	var _version = json.get(\"version\")
	
	for msg in json.get(\"messages\", []):
		var item = self.NoticeItem.instantiate()
		self.nList.add_child(item)
		item.init(msg.get(\"time\"), msg.get(\"message\"))


func _on_close_requested() -> void:
	self.hide()
"

