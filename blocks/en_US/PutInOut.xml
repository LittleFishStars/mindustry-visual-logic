	<Block name="Format" export="format %content">
		<Text id="T1">Format</Text>
		<Text id="T2">"</Text>
		<LineBox id="content" placeholder="frog" />
		<Text id="T3">"</Text>
		<Button id="txt" text="TXT">
			<Pressed show="T1 T2 content T3 txt">
                <Export>
					<Literal>format</Literal><Literal>"</Literal><Field id="content" glue="true" /><Literal glue="true">"</Literal>
                </Export>
            </Pressed>
			<Released show="T1 content txt">
                <Export>
					<Literal>format</Literal><Field id="content" />
                </Export>
            </Released>
        </Button>
    </Block>
</Kind>
