<Kind name="Logics" color="#4199a8">
	<Block name="Wait">
		<Literal>wait</Literal>
		<Field id="time" />
		<Row>
			<Text id="T1">Wait</Text>
			<LineBox id="time" placeholder="0.5" />
			<Text id="T2">sec</Text>
		</Row>
	</Block>
	<Block name="Stop">
		<Literal>stop</Literal>
		<Row>
			<Text id="T">Stop</Text>
		</Row>
	</Block>
	<Block name="End">
		<Literal>end</Literal>
		<Row>
			<Text id="T">End</Text>
		</Row>
	</Block>
	<Block name="JumpLabel">
		<Field id="label" glue="true" />
		<Literal glue="true">:</Literal>
		<Row>
			<Text id="T1">Label</Text>
			<LineBox id="label" placeholder="label1" />
		</Row>
	</Block>
	<Block name="Expression">
		<Literal>#</Literal>
		<!-- 注释就是 `#` 加文本：空文本时不要被补成 `# 0`（那样导回来内容就变了） -->
		<Field id="text" allow_empty="true" />
		<Row>
			<Text id="T1">Expression</Text>
			<LineBox id="text" />
		</Row>
	</Block>
	<Block name="Jump">
		<Literal>jump</Literal>
		<Field id="target" link="true" />
		<Field id="cmp" />
		<Field id="value1" />
		<Field id="value2" />
		<Row>
			<Text id="T1">Jump</Text>
			<JumpTarget id="target" />
			<Text id="T2">if</Text>
			<LineBox id="value1" placeholder="x" />
			<Option id="cmp">
			<Item>equal</Item>
			<Item>notEqual</Item>
			<Item>lessThan</Item>
			<Item>lessThanEq</Item>
			<Item>greaterThan</Item>
			<Item>greaterThanEq</Item>
			<Item>strictEqual</Item>
			<Item>always</Item>
		</Option>
			<LineBox id="value2" placeholder="false" />
		</Row>
	</Block>
	<Block name="If">
		<Row>
			<Text id="T1">If</Text>
			<LineBox id="a" placeholder="a" />
			<Option id="cmp">
			<Item>equal</Item>
			<Item>notEqual</Item>
			<Item>lessThan</Item>
			<Item>lessThanEq</Item>
			<Item>greaterThan</Item>
			<Item>greaterThanEq</Item>
			<Item>strictEqual</Item>
			<Item>always</Item>
		</Option>
			<LineBox id="b" placeholder="b" />
			<Nest id="nest" />
		</Row>
	</Block>
</Kind>
